MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/myapp?authSource=admin

# Local file storage (RustFS from compose.yaml). On the platform, "Add S3 storage" sets these.
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=devpassword
S3_REGION=us-east-1
S3_BUCKET=the-moment
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
