{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "heic2any": "^0.0.4",
    "mongodb": "^7.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@mit-sdg/sync-engine-analysis": "1.1.0",
    "@mit-sdg/sync-engine-catalog": "1.1.0",
    "@mit-sdg/sync-engine-skill": "1.1.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": ">=6 <7",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit",
    "start": "bun src/main.ts",
    "start:backend": "HOST=127.0.0.1 PORT=4000 bun src/main.ts",
    "start:frontend": "HOST=0.0.0.0 BACKEND_URL=http://127.0.0.1:4000 bun web/server.ts",
    "check:design": "sync-engine check-design design/concepts/*.md design/types.md design/compositions/*.md",
    "dev": "bun run db:up && bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun --watch src/main.ts",
    "dev:frontend": "vite",
    "up": "podman compose up -d --build && bun scripts/check-api.ts http://127.0.0.1:8080 --wait",
    "down": "podman compose down",
    "logs": "podman compose logs backend frontend",
    "db:up": "podman compose up -d mongo storage storage-setup",
    "db:shell": "podman compose exec mongo mongosh -u dev -p dev",
    "db:logs": "podman compose logs mongo",
    "db:reset": "podman compose down -v",
    "build": "vite build",
    "test": "MONGODB_URL='mongodb://dev:dev@127.0.0.1:27017/themoment_test?authSource=admin' S3_BUCKET=the-moment-test bun test",
    "preview": "bun run db:up && bun run build && NODE_ENV=production PORT=3000 PUBLIC_ORIGIN=http://127.0.0.1:3000 bun run start",
    "test:web": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "test:all": "bun run test && bun run test:web && bun run test:e2e"
  }
}
